<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>circle_detector</name>
  <version>0.1.0</version>
  <description>Acha a base circular azul (fase4_itjbx) via cv2.HoughCircles e por onde a linha sai dela, publica BaseCircle. Roda so' no comeco da missao e se auto-encerra.</description>
  <maintainer email="evtol.ita@gmail.com">evtol-ita</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>custom_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
