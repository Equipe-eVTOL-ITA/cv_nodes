<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>red_line_detector</name>
  <version>0.1.0</version>
  <description>Detecta a mangueira vermelha entre os postes (fase4_itjbx) na câmera vertical, mesma técnica do lane_detector (regiões de interesse + regressão), publica LaneDirection</description>
  <maintainer email="evtol.ita@gmail.com">evtol-ita</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>custom_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
